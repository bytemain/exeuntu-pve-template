[Unit]
Description=Exeuntu console autologin (exedev)
Documentation=https://github.com/bytemain/exeuntu-pve-template
After=systemd-user-sessions.service getty-pre.target
Conflicts=rescue.service
Before=getty.target
ConditionPathExists=/dev/console

[Service]
# Open the PVE console directly into the non-root exedev user with no key or
# password. The outer surface (PVE login / Raft login) is the access boundary.
ExecStart=-/sbin/agetty --autologin exedev --noclear --keep-baud - 115200,38400,9600 linux
Type=idle
Restart=always
RestartSec=0
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=console
StandardInput=tty
StandardOutput=tty
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Exeuntu web terminal (ttyd, exedev)
Documentation=https://github.com/bytemain/exeuntu-pve-template
After=network-online.target
Wants=network-online.target

[Service]
User=exedev
Group=exedev
WorkingDirectory=/home/exedev
# Binds to the container's eth0 private-bridge address (not loopback, not
# 0.0.0.0) so the Raft-authenticated bridge gateway is the only path in.
# The bind address is resolved at start by exeuntu-ttyd-start.sh.
ExecStart=/usr/local/sbin/exeuntu-ttyd-start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target